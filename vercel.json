{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --omit=dev",
  "buildCommand": "node scripts/build-web.mjs",
  "outputDirectory": "dist-web",
  "regions": [
    "fra1"
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/scan.js": {
      "maxDuration": 300,
      "includeFiles": "src/common/{extract,generic-extract}.js"
    }
  },
  "crons": [
    { "path": "/api/scan?passage=1", "schedule": "0 1 * * *" },
    { "path": "/api/scan?passage=2", "schedule": "0 2 * * *" },
    { "path": "/api/scan?passage=3", "schedule": "0 3 * * *" },
    { "path": "/api/scan?passage=4", "schedule": "0 4 * * *" },
    { "path": "/api/scan?passage=5", "schedule": "0 5 * * *" }
  ]
}
