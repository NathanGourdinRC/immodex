{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --omit=dev",
  "buildCommand": "node scripts/build-web.mjs",
  "outputDirectory": "dist-web",
  "regions": [
    "fra1"
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/scan.js": {
      "maxDuration": 300,
      "includeFiles": "src/common/{extract,generic-extract}.js"
    }
  },
  "crons": [
    {
      "path": "/api/scan",
      "schedule": "0 2 * * *"
    }
  ]
}
