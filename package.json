{
  "name": "immodex-plus",
  "version": "0.26.0",
  "private": true,
  "description": "Outils de développement d'Immodex+ (tests) et dépendance du scan côté serveur (jsdom). L'extension elle-même n'a aucune dépendance.",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
