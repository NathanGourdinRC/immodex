{
  "manifest_version": 3,
  "name": "Immodex+",
  "version": "0.9.0",
  "description": "Adresse réelle d'une annonce immobilière via les DPE (ADEME) et le cadastre (IGN), ventes passées (DVF) et suivi des republications.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Immodex+",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://data.ademe.fr/*",
    "https://apicarto.ign.fr/*",
    "https://geo.api.gouv.fr/*",
    "https://api-adresse.data.gouv.fr/*",
    "https://app.dvf.etalab.gouv.fr/*",
    "https://tabular-api.data.gouv.fr/*",
    "https://cadastre.data.gouv.fr/*",
    "https://immodex.vercel.app/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.leboncoin.fr/ad/*",
        "https://www.leboncoin.fr/vi/*",
        "https://www.leboncoin.fr/locations/*",
        "https://www.leboncoin.fr/ventes_immobilieres/*"
      ],
      "js": [
        "src/common/extract.js",
        "src/common/generic-extract.js",
        "src/ui/styles.js",
        "src/ui/components.js",
        "src/ui/overlay.js",
        "src/content/leboncoin.js",
        "src/content/tracker.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.bienici.com/*",
        "https://bienici.com/*"
      ],
      "js": [
        "src/common/extract.js",
        "src/common/generic-extract.js",
        "src/ui/styles.js",
        "src/ui/components.js",
        "src/ui/overlay.js",
        "src/content/bienici.js",
        "src/content/tracker.js"
      ],
      "run_at": "document_idle"
