{
  "manifest_version": 3,
  "name": "Immodex+",
  "version": "0.3.0",
  "description": "Trouve l'adresse réelle d'une annonce immobilière (Leboncoin, Bienici, SeLoger et sites d'agences) via le registre ADEME des DPE et le cadastre IGN. Historique des recherches sur 7 jours.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Immodex+",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://data.ademe.fr/*",
    "https://apicarto.ign.fr/*",
    "https://geo.api.gouv.fr/*",
    "https://api-adresse.data.gouv.fr/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.leboncoin.fr/ad/*",
        "https://www.leboncoin.fr/vi/*",
        "https://www.leboncoin.fr/locations/*",
        "https://www.leboncoin.fr/ventes_immobilieres/*"
      ],
      "js": [
        "src/common/extract.js",
        "src/ui/styles.js",
        "src/ui/components.js",
        "src/ui/overlay.js",
        "src/content/leboncoin.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.bienici.com/*",
        "https://bienici.com/*"
      ],
      "js": [
        "src/common/extract.js",
        "src/ui/styles.js",
        "src/ui/components.js",
        "src/ui/overlay.js",
        "src/content/bienici.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.seloger.com/annonces/*",
        "https://www.seloger.com/*.htm"
      ],
      "js": [
        "src/common/extract.js",
        "src/ui/styles.js",
        "src/ui/components.js",
        "src/ui/overlay.js",
        "src/content/seloger.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://immobilier.lefigaro.fr/annonces/*",
        "https://www.pap.fr/annonces/*",
        "https://www.iadfrance.fr/annonce/*",
        "https://www.orpi.com/annonce-*",
        "https://www.safti.fr/annonces/*",
        "https://www.century21.fr/trouver_logement/detail/*",
        "https://www.laforet.com/agence-immobiliere/*",
        "https://fr.foncia.com/location/*",
        "https://fr.foncia.com/achat/*",
        "https://www.citya.com/annonces/*",
        "https://www.paruvendu.fr/immobilier/*",
        "https://www.squarehabitat.fr/*",
        "https://www.immobilier.notaires.fr/fr/annonce-immo/*",
        "https://www.vacherand.fr/immobilier/*",
        "https://www.abrinor.fr/annonce/*"
      ],
      "js": [
        "src/common/extract.js",
        "src/common/generic-extract.js",
        "src/ui/styles.js",
        "src/ui/components.js",
        "src/ui/overlay.js",
        "src/content/generic.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
